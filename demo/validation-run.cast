[0.008343, "o", "\u001b[1mfos-cazavi — full validation run, logged for provenance\u001b[0m\r\n\r\n\u001b[2m# Start a dochist session: every command and every artifact it produces is recorded.\u001b[0m\r\n"]
[0.610468, "o", "\u001b[1;32m$\u001b[0m dochist init fos-cazavi-validation -d 'Validation across six published genome sets'\r\n"]
